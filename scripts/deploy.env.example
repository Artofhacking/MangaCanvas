# Optional values for the local SSH fallback (`npm run deploy`).
# Production publish uses the ECS self-hosted runner and does not need these.
# Do not commit real keys.

MANGACANVAS_SSH_HOST=47.104.138.144
MANGACANVAS_SSH_USER=ecs-user
MANGACANVAS_SSH_KEY=/path/to/your.pem
MANGACANVAS_HTTP_PORT=18999
# Opt-in. config.py defaults are billing_enabled=False and billing_enforce_quotas=False.
# Production must set BILLING_ENABLED and BILLING_ENFORCE_QUOTAS explicitly.
# Unset (or 0) keeps charging and quota enforcement off. Do not flip these to 1 here
# unless this environment is intentionally turning billing on.
BILLING_ENABLED=0
BILLING_ENFORCE_QUOTAS=0
ALLOW_PLACEHOLDER=0
